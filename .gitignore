# Dependencies - always reinstalled with `npm install`
node_modules/

# Build output - regenerated with `npm run build`
dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files - contain real secrets (never commit these)
.env
.env.*

# ...but keep the public template committed (placeholders only)
!.env.example

# Test coverage reports - regenerated when tests run
coverage/

# Editor settings (personal) - except the shared extensions list
.vscode/*
!.vscode/extensions.json
.idea/

# OS-specific junk files
.DS_Store
Thumbs.db
