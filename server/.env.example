# TaskFlow API - environment template.
# Copy this file to .env and adjust the values for your machine.
# Never commit .env - it may contain real secrets in later phases.

# Port the API listens on
PORT=3000

# Origin allowed to call the API (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string used by Prisma (Phase 10+).
# Replace change_me with the local taskflow_app password.
# Never commit the real .env file.
DATABASE_URL="postgresql://taskflow_app:change_me@localhost:5432/taskflow_dev"

# Isolated database used only by `npm test`. It must be different from
# DATABASE_URL and use the taskflow_test database name.
TEST_DATABASE_URL="postgresql://taskflow_app:change_me@localhost:5432/taskflow_test?schema=public"

# Secret used to sign JWTs (Phase 11+). Replace with a random value of at least 32 characters.
# Generate one locally and never commit the real .env file.
JWT_SECRET=replace_me_with_a_random_secret_at_least_32_characters

# How long an access token stays valid (defaults to 7d).
JWT_EXPIRES_IN=7d

# Dedicated database for optional demo data. Never point this at taskflow_dev.
# Create and migrate taskflow_demo before running `npm run db:seed:demo`.
DEMO_DATABASE_URL="postgresql://taskflow_app:change_me@localhost:5432/taskflow_demo?schema=public"

# Demo account created by the seed script. Use a unique demo-only password.
DEMO_USER_NAME="Demo User"
DEMO_USER_EMAIL="demo@taskflow.local"
DEMO_USER_PASSWORD="replace_me_with_a_demo_password"
